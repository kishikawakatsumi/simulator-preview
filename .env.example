# Local demo: npm run demo:build && npm run build && npm run demo
PREVIEW_PORT=8091
PREVIEW_AUTH=local
PREVIEW_ORIGIN=http://127.0.0.1:8091
PREVIEW_MAX_SESSIONS=2
PREVIEW_MAX_VIEWERS=4
PREVIEW_SESSION_IDLE_SECONDS=60
PREVIEW_STATE_DIR=.preview

# Real GitHub mode: leave PREVIEW_DEMO unset and fill in these values.
# PREVIEW_REPOSITORY=YOUR_GITHUB_OWNER/simulator-preview
# GITHUB_TOKEN=  # Fine-grained PAT: this repo only; Actions read + Pull requests read.
# PREVIEW_WORKFLOW=.github/workflows/simulator-preview-build.yml

# Public host: set PREVIEW_AUTH=access and PREVIEW_ORIGIN=https://your-hostname
# CF_ACCESS_ISSUER=https://YOUR_TEAM.cloudflareaccess.com
# CF_ACCESS_AUD=
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# PREVIEW_RELAY_ONLY=1
