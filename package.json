{
  "name": "simulator-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build:web && npm run build:native",
    "build:web": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && node scripts/copy-assets.mjs",
    "build:native": "node scripts/build-native.mjs",
    "start": "node --env-file-if-exists=.env dist/server/main.js",
    "devices": "xcrun simctl list devices available",
    "test": "npm run build:web && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:simulator": "node tests/simulator.mjs",
    "format": "prettier --write server web tests scripts deploy package.json tsconfig.json && swift format format --in-place --recursive native/Sources/SimulatorHost",
    "demo:build": "bash scripts/build-preview.sh",
    "demo": "PREVIEW_DEMO=1 npm start"
  },
  "dependencies": {
    "jose": "6.2.17",
    "node-datachannel": "0.33.6",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "playwright": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
